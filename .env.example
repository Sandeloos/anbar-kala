# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# The address people open, without https:// (a DNS A record must point it to this server)
DOMAIN=anbar.example.ir
# A long random string (64+ characters). It encrypts the WooCommerce keys in the database:
# keep it with the backups; without it the keys in a backup cannot be read. Never change it later.
#   openssl rand -base64 48
APP_SECRET=

# The first manager, created on the first start only (change the password after signing in)
MANAGER_USERNAME=admin
MANAGER_PASSWORD=
MANAGER_NAME=مدیر

# 1 = cookies only over HTTPS (normal). 0 only for a first test without HTTPS.
COOKIE_SECURE=1

# Optional: images from a registry mirror reachable from the server (see docs/deploy.md)
# ANBAR_IMAGE=anbar:latest
# CADDY_IMAGE=caddy:2.8-alpine
