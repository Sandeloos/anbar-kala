{
  "name": "anbar",
  "version": "0.1.0",
  "private": true,
  "description": "انبار — consignment warehouse, order and settlement software for Sandeloos (RTL, Persian).",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch-path=server --watch-path=public server/dev.js",
    "demo": "node server/dev.js --demo",
    "db:seed": "node server/seed.js",
    "mock:woo": "node tools/mock-woo.js",
    "lint": "eslint . && php -l wordpress-plugin/anbar-connector/anbar-connector.php",
    "test:unit": "TZ=Asia/Tehran node --test \"tests/unit/*.test.js\"",
    "test:coverage": "TZ=Asia/Tehran node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-exclude='tools/**' --test-coverage-lines=90 --test-coverage-branches=68 --test-coverage-functions=85 \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run lint && npm run test:coverage && npm run test:e2e",
    "bench": "node tools/bench.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.9",
    "exceljs": "4.4.0",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
